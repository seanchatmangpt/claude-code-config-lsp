# ══════════════════════════════════════════════════════════════════════════════
# Lane P9 (hand-written append): slash-command markdown surface
# ConfigSurface + DiagnosticRule individuals ONLY — existing entries untouched.
# ══════════════════════════════════════════════════════════════════════════════

ccc:CommandsMarkdown
    a ccc:ConfigSurface ;
    ccc:filePattern "**/.claude/commands/*.md" ;
    ccc:languageId "markdown" ;
    ccc:analyzerModule "commands" ;
    ccc:analyzerModulePascal "Commands" ;
    ccc:parserKind "markdown" .

ccc:CMD-001
    a ccc:DiagnosticRule ;
    ccc:diagCode "CCC-CMD-001" ;
    ccc:diagFamily "commands" ;
    ccc:diagSurface ccc:CommandsMarkdown ;
    ccc:diagMessage "Command has no description (frontmatter description or H1 title)" ;
    ccc:diagSeverity "warning" ;
    ccc:diagLawAxis "Protocol" .

ccc:CMD-002
    a ccc:DiagnosticRule ;
    ccc:diagCode "CCC-CMD-002" ;
    ccc:diagFamily "commands" ;
    ccc:diagSurface ccc:CommandsMarkdown ;
    ccc:diagMessage "argument-hint implies arguments but body has no $ARGUMENTS placeholder" ;
    ccc:diagSeverity "warning" ;
    ccc:diagLawAxis "Protocol" .

ccc:CMD-003
    a ccc:DiagnosticRule ;
    ccc:diagCode "CCC-CMD-003" ;
    ccc:diagFamily "commands" ;
    ccc:diagSurface ccc:CommandsMarkdown ;
    ccc:diagMessage "@file reference does not resolve relative to the command file" ;
    ccc:diagSeverity "error" ;
    ccc:diagLawAxis "Protocol" .

ccc:CMD-004
    a ccc:DiagnosticRule ;
