# ── Enum constraints from src/analyzers/json.rs ──

ccc:enum_hookTypes a ccc:EnumConstraint ;
    ccc:enumFor "hooks.<event>[].hooks[].type (CCC-HOOK-004)" ;
    ccc:enumValues "command prompt agent http mcp_tool" .

ccc:enum_worktreeBaseRef a ccc:EnumConstraint ;
    ccc:enumFor "worktree.baseRef (CCC-JSON-008)" ;
    ccc:enumValues "fresh head" .

ccc:enum_skillOverrides a ccc:EnumConstraint ;
    ccc:enumFor "skillOverrides.<skill> (CCC-JSON-009)" ;
    ccc:enumValues "on off name-only user-invocable-only" .

ccc:enum_parentSettingsBehavior a ccc:EnumConstraint ;
    ccc:enumFor "parentSettingsBehavior (CCC-JSON-010)" ;
    ccc:enumValues "first-wins merge" .

ccc:enum_mcpServerTypes a ccc:EnumConstraint ;
    ccc:enumFor "mcpServers.<name>.type (CCC-JSON-011)" ;
    ccc:enumValues "stdio sse" .

ccc:enum_models a ccc:EnumConstraint ;
    ccc:enumFor "model (CCC-JSON-004)" ;
    ccc:enumValues "opus sonnet haiku fable claude-opus-5 claude-sonnet-5 claude-fable-5 claude-haiku-4-5-20251001" .

ccc:enum_effortLevels a ccc:EnumConstraint ;
    ccc:enumFor "effortLevel (CCC-JSON-005)" ;
    ccc:enumValues "low medium high xhigh max" .

ccc:enum_permissionModes a ccc:EnumConstraint ;
    ccc:enumFor "permissionMode / permissions.defaultMode (CCC-JSON-006)" ;
    ccc:enumValues "default manual plan acceptEdits bypassPermissions auto" .

