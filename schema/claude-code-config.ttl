# --- ontology reconciliation (P10): analyzers richer than TTL, encode the delta ---
# Evidence sources (authorities, cited per individual):
#   src/analyzers/json.rs        — VALID_HOOK_EVENTS, VALID_HOOK_TYPES,
#                                  VALID_WORKTREE_BASE_REFS, VALID_SKILL_OVERRIDES,
#                                  VALID_PARENT_SETTINGS_BEHAVIOR, VALID_MCP_SERVER_TYPES,
#                                  VALID_MODELS, VALID_EFFORT_LEVELS, VALID_PERMISSION_MODES,
#                                  deprecated-key rules CCC-JSON-001/002/013
#   src/analyzers/frontmatter.rs — VALID_CONTEXT_VALUES, VALID_AGENT_EFFORT_LEVELS,
#                                  1024-char description limit (CCC-AGENT-005)
#   src/analyzers/commands.rs    — allowed-tools / disable-model-invocation validation
#   src/file_types.rs            — SUPPORTED_FILE_TYPES languageId authority
# Court: tests/ttl_reconciliation.rs (bidirectional text-level anti-drift fence).
# The TTL here catches UP to the hand-written analyzers; it does not replace them.

ccc:HookEvent         a rdfs:Class ; rdfs:label "Hook Event" ; rdfs:comment "A valid hooks-object event name (authority: analyzers/json.rs VALID_HOOK_EVENTS)" .
ccc:EnumConstraint    a rdfs:Class ; rdfs:label "Enum Constraint" ; rdfs:comment "A closed value set enforced by an analyzer enum table" .
ccc:DeprecatedKey     a rdfs:Class ; rdfs:label "Deprecated Key" ; rdfs:comment "A config key the analyzers flag as deprecated (DiagnosticRule-adjacent)" .
ccc:LanguageId        a rdfs:Class ; rdfs:label "Language Id" ; rdfs:comment "Canonical LSP languageId (authority: src/file_types.rs SUPPORTED_FILE_TYPES)" .

ccc:eventName         a rdf:Property ; rdfs:label "Event Name" ; rdfs:comment "The literal hook-event string on the wire" .
ccc:enumFor           a rdf:Property ; rdfs:label "Enum For" ; rdfs:comment "Settings field this enum constrains" .
ccc:enumValues        a rdf:Property ; rdfs:label "Enum Values" ; rdfs:comment "Space-separated closed value set" .
ccc:deprecatedKey     a rdf:Property ; rdfs:label "Deprecated Key" ; rdfs:comment "The deprecated key literal" .
ccc:replacementKey    a rdf:Property ; rdfs:label "Replacement Key" ; rdfs:comment "What to use instead" .
ccc:diagCode          a rdf:Property ; rdfs:label "Diag Code" ; rdfs:comment "Diagnostic code that fires for this key" .
ccc:languageIdValue   a rdf:Property ; rdfs:label "Language Id Value" ; rdfs:comment "The languageId string" .

